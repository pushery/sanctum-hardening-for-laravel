{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "pushery/sanctum-hardening-for-laravel",
  "description": "Hardens Laravel Sanctum: token abilities without a wildcard, limits on minting, per-token and per-user throttling, and a switch that removes the API.",
  "keywords": [
    "laravel",
    "sanctum",
    "hardening",
    "api-tokens",
    "abilities",
    "rate-limiting",
    "security"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pushery"
    }
  ],
  "type": "library",
  "homepage": "https://github.com/pushery/sanctum-hardening-for-laravel",
  "support": {
    "issues": "https://github.com/pushery/sanctum-hardening-for-laravel/issues",
    "source": "https://github.com/pushery/sanctum-hardening-for-laravel",
    "docs": "https://docs.pushery.com/sanctum-hardening-for-laravel/",
    "security": "https://github.com/pushery/sanctum-hardening-for-laravel/security/policy"
  },
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-filter": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "illuminate/cache": "^13.0",
    "illuminate/console": "^13.0",
    "illuminate/container": "^13.0",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/events": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/view": "^13.0",
    "laravel/sanctum": "^4.0",
    "symfony/console": "^7.0 || ^8.0",
    "symfony/http-foundation": "^7.0 || ^8.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.9.3",
    "laravel/ai": "^1.0",
    "laravel/boost": "^2.9",
    "laravel/mcp": "^1.0",
    "laravel/pao": "^1.1",
    "laravel/pint": "^1.0",
    "livewire/livewire": "^4.3",
    "orchestra/testbench": "^11.2",
    "pestphp/pest": "^5.2.1",
    "pestphp/pest-plugin-agent": "^5.0",
    "pestphp/pest-plugin-browser": "^5.2",
    "pestphp/pest-plugin-evals": "^5.1",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-phpstan": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.0",
    "phpstan/phpstan": "^2.3.0",
    "pushery/sqlens-for-laravel": "^0.33.0",
    "pushery/wirekit": "^2.73.0",
    "rector/rector": "^2.7.0",
    "spaze/phpstan-disallowed-calls": "^4.12",
    "symfony/yaml": "^7.4.17 || ^8.1.5"
  },
  "suggest": {
    "livewire/livewire": "Required to render the optional self-service screen of personal access tokens (Pushery\\SanctumHardening\\SanctumHardeningUiServiceProvider).",
    "pushery/wirekit": "Required to render the self-service screen as shipped, whose view is built from WireKit components. A host on another UI kit publishes the view and restyles it."
  },
  "autoload": {
    "psr-4": {
      "Pushery\\SanctumHardening\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pushery\\SanctumHardening\\SanctumHardeningServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
